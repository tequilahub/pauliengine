# Doxygen configuration for the PauliEngine C++ API.
#
# Only XML is generated; it is rendered by Sphinx through Breathe (see conf.py).
# Run from the docs/ directory:   doxygen Doxyfile
# (sphinx-build does this automatically when doxygen is on PATH.)

PROJECT_NAME           = PauliEngine
OUTPUT_DIRECTORY       = _build/doxygen
INPUT                  = ../include/pauliengine
FILE_PATTERNS          = *.h
RECURSIVE              = NO

GENERATE_XML           = YES
GENERATE_HTML          = NO
GENERATE_LATEX         = NO
XML_PROGRAMLISTING     = NO

# Document every public declaration, also those without a /// comment, so the
# reference is complete; private members stay out of the user documentation.
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
HIDE_UNDOC_RELATIONS   = YES

# `///` blocks: the first sentence becomes the brief description.
JAVADOC_AUTOBRIEF      = YES
QT_AUTOBRIEF           = YES
MARKDOWN_SUPPORT       = YES

ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
PREDEFINED             = PAULIENGINE_HAS_OPENMP

QUIET                  = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_LOGFILE           = _build/doxygen/warnings.log
